---
import Layout from "../layouts/Layout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page not found: Logia" description="This page doesn't exist on the Logia site.">
  <HeroHeader slot="header" />
  <div class="wrap page">
    <p class="caption-4 mono quiet">404</p>
    <h1 class="heading-3 md:heading-2">Page not found</h1>
    <p class="body-3 muted">The link may be old, or the page may have moved.</p>
    <a href="/" class="btn btn-primary">Back to the home page</a>
  </div>
  <Footer />
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--s-200);
    min-height: 80dvh;
    padding-block: var(--s-900);
  }
</style>
