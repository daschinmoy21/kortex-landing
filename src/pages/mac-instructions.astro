---
import Layout from "../layouts/Layout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Footer from "../components/Footer.astro";
import CopyCommand from "../components/CopyCommand.astro";
import { installers, release } from "../data/release";
---

<Layout title="Install Logia on macOS" description="How to install the unsigned macOS build of Logia.">
  <HeroHeader slot="header" />

  <div class="wrap page">
    <h1 class="heading-3 md:heading-2">Installing Logia on macOS</h1>
    <p class="start body-3 muted" data-dmg={installers.dmg}>
      Your download should start automatically. If it doesn't,
      <a class="link" href={installers.dmg}>download v{release.version} manually</a>.
    </p>

    <p class="notice body-6">
      <b>The app is unsigned.</b> There's no Apple Developer account behind it yet, so macOS blocks it unless you follow the
      steps below. It has been tested on macOS 26 Tahoe, and older versions may not work.
    </p>

    <ol class="steps">
      <li class="card">
        <h2 class="title-3">Clear the quarantine attribute</h2>
        <p class="body-6 muted">Run this in Terminal once the download finishes:</p>
        <div class="inset"><CopyCommand command={`xattr -cr ~/Downloads/${installers.dmgName}`} /></div>
      </li>
      <li class="card">
        <h2 class="title-3">Install the app</h2>
        <p class="body-6 muted">Open the DMG and drag <b>Logia</b> to your <b>Applications</b> folder.</p>
      </li>
      <li class="card">
        <h2 class="title-3">Clear the app's attributes</h2>
        <p class="body-6 muted">Run this so the app is allowed to open:</p>
        <div class="inset"><CopyCommand command="xattr -cr /Applications/Logia.app" /></div>
      </li>
    </ol>

    <a href="/downloads" class="link back body-6">Back to downloads</a>
  </div>

  <Footer />
</Layout>

<script>
  const url = document.querySelector<HTMLElement>("[data-dmg]")?.dataset.dmg;
  if (url) setTimeout(() => (window.location.href = url), 1000);
</script>

<style>
  .page {
    max-width: calc(720px + 2 * var(--gutter));
    min-height: 80dvh;
    padding-block: var(--s-900);
  }

  .start {
    margin-top: var(--s-100);
  }

  .notice {
    margin-top: var(--s-300);
  }

  .steps {
    display: grid;
    gap: var(--s-200);
    margin-top: var(--s-400);
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: var(--s-200) var(--s-200) var(--s-200) var(--s-600);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    top: var(--s-200);
    left: var(--s-200);
    color: var(--ember-300);
    font: 500 12px/24px var(--mono);
  }

  .steps p {
    margin-top: var(--s-50);
  }

  .steps b {
    color: var(--ink-100);
    font-weight: 600;
  }

  .inset {
    margin-top: var(--s-100);
  }

  .back {
    display: inline-block;
    margin-top: var(--s-300);
  }
</style>
