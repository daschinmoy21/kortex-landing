---
import Layout from "../layouts/Layout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Footer from "../components/Footer.astro";
import CopyCommand from "../components/CopyCommand.astro";
import { installers, release } from "../data/release";
---

<Layout title="Install Logia on macOS" description="How to install the unsigned macOS build of Logia.">
  <HeroHeader slot="header" />

  <div class="wrap page">
    <h1 class="heading">Installing Logia on macOS</h1>
    <p class="start" data-dmg={installers.dmg}>
      Your download should start automatically. If it doesn't,
      <a class="link" href={installers.dmg}>download v{release.version} manually</a>.
    </p>

    <p class="notice">
      <b>The app is unsigned.</b> There's no Apple Developer account behind it yet, so macOS blocks it unless you follow the
      steps below. It has been tested on macOS 26 Tahoe, and older versions may not work.
    </p>

    <ol class="steps">
      <li>
        <h2>Clear the quarantine attribute</h2>
        <p>Run this in Terminal once the download finishes:</p>
        <div class="well"><CopyCommand command={`xattr -cr ~/Downloads/${installers.dmgName}`} /></div>
      </li>
      <li>
        <h2>Install the app</h2>
        <p>Open the DMG and drag <b>Logia</b> to your <b>Applications</b> folder.</p>
      </li>
      <li>
        <h2>Clear the app's attributes</h2>
        <p>Run this so the app is allowed to open:</p>
        <div class="well"><CopyCommand command="xattr -cr /Applications/Logia.app" /></div>
      </li>
    </ol>

    <a href="/downloads" class="link back">Back to downloads</a>
  </div>

  <Footer />
</Layout>

<script>
  const url = document.querySelector<HTMLElement>("[data-dmg]")?.dataset.dmg;
  if (url) setTimeout(() => (window.location.href = url), 1000);
</script>

<style>
  .page {
    max-width: calc(720px + 2 * var(--gutter));
    min-height: calc(100dvh - 120px);
    padding-block: clamp(48px, 8vw, 88px);
  }

  .start {
    margin-top: 12px;
    color: var(--ink-400);
  }

  .notice {
    margin-top: 24px;
    padding: 12px 14px;
    border: 1px solid rgb(244 122 53 / 0.3);
    border-radius: 8px;
    background: rgb(244 122 53 / 0.06);
    color: var(--ink-300);
    font-size: 14px;
  }

  .notice b {
    color: var(--ember-300);
    font-weight: 600;
  }

  .steps {
    margin-top: 32px;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: 20px 0 20px 40px;
    border-top: 1px solid var(--ink-800);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 20px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--ink-700);
    border-radius: 6px;
    color: var(--ember-300);
    font: 500 12px/1 var(--mono);
  }

  h2 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.6;
  }

  .steps p {
    margin-top: 4px;
    color: var(--ink-400);
    font-size: 15px;
  }

  .steps b {
    color: var(--ink-100);
    font-weight: 600;
  }

  .well {
    margin-top: 10px;
    padding: 6px;
    border: 1px solid var(--ink-800);
    border-radius: 12px;
    background: var(--ink-900);
  }

  .back {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
  }
</style>
