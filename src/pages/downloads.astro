---
import Layout from "../layouts/Layout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Footer from "../components/Footer.astro";
import CopyCommand from "../components/CopyCommand.astro";
import Icon from "../components/Icon.astro";
import { installers, links, nixMainCommand, release } from "../data/release";

const platforms = [
  {
    name: "Windows",
    note: "x64",
    rows: installers.windows.map((item) => ({ ...item, external: true })),
  },
  {
    name: "Linux",
    note: "x64",
    rows: installers.linux.map((item) => ({ ...item, external: true })),
  },
  {
    name: "macOS",
    note: "Apple Silicon, unsigned",
    rows: [{ label: "Disk image (.dmg)", size: "8 MB", href: "/mac-instructions", external: false }],
  },
];
---

<Layout title="Download Logia" description="Download Logia for Linux, Windows and macOS, or run the latest build with Nix.">
  <HeroHeader slot="header" />

  <div class="wrap page">
    <h1 class="heading-3 md:heading-2">Get Logia</h1>

    <section class="latest card" id="main">
      <div>
        <h2 class="title-2">Bleeding edge, with Nix</h2>
        <p class="body-6 muted">
          Builds the main branch from source. You get the newest work before it reaches a release, and it's also the least
          tested way to run Logia.
        </p>
      </div>
      <div class="inset"><CopyCommand command={nixMainCommand} /></div>
    </section>

    <section class="installers">
      <div class="head">
        <h2 class="title-2">Installers</h2>
        <span class="caption-5 quiet mono">v{release.version} · {release.date}</span>
      </div>

      {
        !release.current && (
          <p class="notice body-6">
            <b>These are an older build.</b> They have the previous interface, and no Vim mode or agent panel yet. New
            installers are on the way.
          </p>
        )
      }

      <div class="platforms">
        {
          platforms.map((platform) => (
            <div class="platform card">
              <h3 class="title-3">{platform.name}</h3>
              <p class="caption-5 quiet mono">{platform.note}</p>
              <ul>
                {platform.rows.map((row) => (
                  <li>
                    <a href={row.href} class="body-6" {...(row.external ? { rel: "noopener noreferrer" } : {})}>
                      <span>{row.label}</span>
                      <span class="size caption-5 mono">{row.size}</span>
                      <Icon name="download" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <p class="more body-6 muted">
      Audio transcription also needs Python 3.12+ and FFmpeg. Every release is on
      <a class="link" href={links.releases} target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </div>

  <Footer />
</Layout>

<style>
  .page {
    max-width: calc(960px + 2 * var(--gutter));
    min-height: 80dvh;
    padding-block: var(--s-900);
  }

  .latest {
    display: grid;
    gap: var(--s-200);
    margin-top: var(--s-400);
    padding: var(--s-75);
  }

  .latest > div:first-child {
    padding: var(--s-200) var(--s-200) 0;
  }

  .latest p {
    margin-top: var(--s-50);
    max-width: 680px;
  }

  .installers {
    margin-top: var(--s-600);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-50) var(--s-200);
  }

  .notice {
    margin-top: var(--s-200);
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-200);
    margin-top: var(--s-200);
  }

  .platform {
    padding: var(--s-75);
  }

  h3,
  .platform > p {
    padding-inline: var(--s-100);
  }

  h3 {
    padding-top: var(--s-100);
  }

  ul {
    display: grid;
    gap: var(--s-50);
    margin-top: var(--s-100);
  }

  li a {
    display: flex;
    align-items: center;
    gap: var(--s-75);
    padding: var(--s-100);
    border-radius: 8px;
    color: var(--ink-200);
    transition:
      background-color 300ms var(--curve),
      transform 500ms var(--curve);
  }

  li a:hover {
    background: var(--bg-3);
  }

  li a:active {
    transform: scale(0.98);
  }

  .size {
    margin-left: auto;
    color: var(--ink-500);
    white-space: nowrap;
  }

  .more {
    margin-top: var(--s-400);
  }
</style>
