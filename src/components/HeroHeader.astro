---
import { links } from "../data/release";
import { starCount } from "../data/stars";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const stars = await starCount();
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, "")}k+` : String(n));
---

<header class="bar">
  <div class="wrap inner">
    <a href="/" class="mark" aria-current={path === "/" ? "page" : undefined}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      Logia
    </a>
    <nav aria-label="Main" class="links">
      <a href="/downloads" class="download" aria-current={path === "/downloads" ? "page" : undefined}>Download</a>
      <a href={links.repo} class="item stars" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"></path></svg>
        {
          stars === null ? (
            <span>Star<span class="long"> on GitHub</span></span>
          ) : (
            <span><b>{compact(stars)}</b><span class="long"> GitHub {stars === 1 ? "star" : "stars"}</span></span>
          )
        }
      </a>
    </nav>
  </div>
</header>

<style>
  /* Sits over the top of the page rather than pushing it down, so the background runs behind it. */
  .bar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 50;
    /* No fill: a soft shadow keeps the text readable over the bright band of the background. */
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.75), 0 0 2px rgb(0 0 0 / 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      animation: drop 900ms var(--curve) 350ms backwards;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(calc(-1 * var(--s-300)));
    }
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-200);
    padding-block: var(--s-300);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-75);
    color: #ffffff;
    font: 600 20px/28px var(--sans);
    letter-spacing: -0.02em;
  }

  .mark img {
    display: block;
    border-radius: 7px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--s-400);
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-75);
    color: var(--ink-100);
    font: 500 16px/24px var(--sans);
    white-space: nowrap;
    transition: color 300ms var(--curve);
  }

  .item:hover,
  .item[aria-current="page"] {
    color: #ffffff;
  }

  /* The one button in the bar: see-through, with a plain white outline. */
  .download {
    padding: var(--s-75) var(--s-200);
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: 8px;
    background: rgb(0 0 0 / 0.18);
    color: #ffffff;
    font: 600 15px/20px var(--sans);
    white-space: nowrap;
    transition: background-color 300ms var(--curve);
  }

  .download:hover,
  .download[aria-current="page"] {
    background: rgb(255 255 255 / 0.08);
  }

  .stars svg {
    width: 16px;
    height: 16px;
    color: #ffd166;
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.7));
  }

  .stars b {
    color: #ffffff;
    font-weight: 600;
  }

  /* Phones: stars shrink to icon + count, and Download moves to the right edge. */
  @media (max-width: 599px) {
    .links {
      gap: var(--s-200);
    }

    .download {
      order: 1;
    }

    .long {
      display: none;
    }

    .item,
    .download {
      font-size: 14px;
    }
  }
</style>
