---
import { links } from "../data/release";
---

<header class="bar">
  <div class="wrap row">
    <a href="/" class="mark">Logia</a>
    <nav aria-label="Main">
      <a href="/#keyboard" class="item hide-narrow">Keyboard</a>
      <a href="/#agents" class="item hide-narrow">Agents</a>
      <a href="/#everything" class="item hide-narrow">Features</a>
      <a href={links.repo} class="item" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/downloads" class="btn btn-primary compact">Download</a>
    </nav>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ink-800);
    background: var(--ink-925);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }

  .mark {
    font: 700 15px/1 var(--mono);
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .item {
    padding: 8px 10px;
    border-radius: 6px;
    color: var(--ink-400);
    font-size: 14px;
    line-height: 1;
    transition: background-color 0.12s, color 0.12s;
  }

  .item:hover {
    background: var(--ink-900);
    color: var(--ink-100);
  }

  .compact {
    min-height: 32px;
    margin-left: 8px;
    padding: 0 12px;
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .hide-narrow {
      display: none;
    }
  }
</style>
