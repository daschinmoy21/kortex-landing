---
// Phosphor icons, regular weight (B6). Only the two the site uses, so no icon package is needed.
const icons = {
  download:
    "M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z",
  plus: "M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z",
};

interface Props {
  name: keyof typeof icons;
}
const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d={icons[name]}></path></svg>

<style>
  .icon {
    display: block;
    flex: none;
    width: var(--s-200);
    height: var(--s-200);
  }
</style>
