---
// An ordered-dither (Bayer 8x8) haze drawn behind a card: a slow-drifting ember field that hangs
// from the top edge and fades out before the card's text. The parent must be position: relative
// with overflow hidden; content that should sit above it needs position: relative too.
// x biases the brightest part of the haze across the card (0 left, 1 right), spread is how far down
// the card it reaches as a fraction of its height, and cell is the size of one dither pixel in CSS
// pixels. y is kept for older call sites and ignored.
interface Props {
  x?: number;
  y?: number;
  spread?: number;
  cell?: number;
  class?: string;
}
const { x = 0.5, y = 0, spread = 0.8, cell = 3, class: className } = Astro.props;
---

<canvas
  class:list={["dither", className]}
  data-dither
  data-x={x}
  data-y={y}
  data-spread={spread}
  data-cell={cell}
  aria-hidden="true"></canvas>

<script>
  // Bayer 8x8 thresholds, 0..63.
  const bayer = [
    0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4, 36, 14, 46, 6, 38, 60, 28, 52, 20, 62, 30, 54, 22, 3,
    35, 11, 43, 1, 33, 9, 41, 51, 19, 59, 27, 49, 17, 57, 25, 15, 47, 7, 39, 13, 45, 5, 37, 63, 31, 55, 23, 61, 29, 53, 21,
  ];

  // How far each canvas has dissolved in, from 0 (empty) to 1 (full).
  const progress = new WeakMap<HTMLCanvasElement, number>();
  const visible = new Set<HTMLCanvasElement>();
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const born = performance.now();

  const draw = (canvas: HTMLCanvasElement, now: number) => {
    const box = canvas.getBoundingClientRect();
    const cell = Number(canvas.dataset.cell) || 3;
    const w = Math.max(1, Math.round(box.width / cell));
    const h = Math.max(1, Math.round(box.height / cell));
    if (canvas.width !== w || canvas.height !== h) {
      canvas.width = w;
      canvas.height = h;
    }

    const context = canvas.getContext("2d");
    if (!context) return;
    const ramp = progress.get(canvas) ?? 0;
    const image = context.createImageData(w, h);
    const bias = Number(canvas.dataset.x);
    const reach = Math.max(0.15, Math.min(0.9, Number(canvas.dataset.spread) || 0.6)) * h;
    // Seconds; the waves move slowly so the haze drifts rather than flickers.
    const t = calm ? 0 : (now - born) / 1000;

    for (let row = 0; row < h; row++) {
      // Hangs from the top edge and is gone by `reach`.
      const fall = Math.max(0, 1 - row / reach) ** 1.4;
      if (fall <= 0) break;
      const py = row * cell;
      for (let col = 0; col < w; col++) {
        const px = col * cell;
        // A few overlapping sine waves make a soft, wandering field with no single hot spot.
        const wave =
          (Math.sin(px * 0.011 + t * 0.35) +
            Math.sin(py * 0.02 - t * 0.27 + px * 0.004) +
            Math.sin((px - py * 1.5) * 0.007 + t * 0.19)) /
          3;
        const lean = 1 - 0.55 * Math.abs(col / w - bias);
        const v = (0.35 + 0.65 * (0.5 + 0.5 * wave)) * fall * lean * ramp;
        const threshold = (bayer[(row % 8) * 8 + (col % 8)] + 0.5) / 64;
        if (v <= threshold) continue;
        const i = (row * w + col) * 4;
        image.data[i] = 244;
        image.data[i + 1] = 122;
        image.data[i + 2] = 53;
        image.data[i + 3] = Math.round(60 + 110 * v);
      }
    }
    context.putImageData(image, 0, 0);
  };

  // One shared loop for every visible canvas, capped near 20fps since the motion is slow.
  let last = 0;
  let running = false;
  const tick = (now: number) => {
    if (visible.size === 0) {
      running = false;
      return;
    }
    if (now - last > 50) {
      last = now;
      visible.forEach((canvas) => draw(canvas, now));
    }
    requestAnimationFrame(tick);
  };
  const run = () => {
    if (calm || running) return;
    running = true;
    requestAnimationFrame(tick);
  };

  // Fades the haze in through the Bayer thresholds; the shared loop does the drawing.
  const dissolve = (canvas: HTMLCanvasElement) => {
    if (calm) {
      progress.set(canvas, 1);
      draw(canvas, performance.now());
      return;
    }
    // Waits for the card's own scroll reveal to get going.
    const start = performance.now() + 200;
    const step = (now: number) => {
      const linear = Math.min(1, Math.max(0, (now - start) / 1400));
      progress.set(canvas, 1 - (1 - linear) ** 3);
      if (linear < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const canvases = [...document.querySelectorAll<HTMLCanvasElement>("canvas[data-dither]")];
  const resize = new ResizeObserver((entries) =>
    entries.forEach((entry) => draw(entry.target as HTMLCanvasElement, performance.now())),
  );
  const seen = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const canvas = entry.target as HTMLCanvasElement;
        if (!entry.isIntersecting) {
          visible.delete(canvas);
          continue;
        }
        visible.add(canvas);
        if (!progress.has(canvas)) {
          progress.set(canvas, 0);
          dissolve(canvas);
        }
        run();
      }
    },
    { rootMargin: "0px 0px -10% 0px" },
  );
  canvases.forEach((canvas) => {
    resize.observe(canvas);
    seen.observe(canvas);
  });
</script>


<style>
  .dither {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
    opacity: 0.45;
    transition: opacity 500ms var(--curve);
  }

  /* Cards light up a little on hover. */
  :global(:hover) > .dither {
    opacity: 0.7;
  }
</style>
