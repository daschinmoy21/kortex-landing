---
import Demo from "./Demo.astro";

// Every binding here comes from the app's README. Keep them in step with it.
// Keys are space separated, one cap each. A "/" after the first key reads as "or".
const groups = [
  {
    name: "Anywhere",
    rows: [
      ["Ctrl P", "Find a note"],
      ["Ctrl Shift P", "Run a command"],
      ["Ctrl H / L", "Move between panes"],
      ["Ctrl \\", "Pin or hide the sidebar"],
    ],
  },
  {
    name: "Leader, with Vim on",
    rows: [
      ["Space e", "File explorer"],
      ["Space f", "Find note"],
      ["Space a", "AI panel"],
      ["Space t", "To do board"],
    ],
  },
  {
    name: "In a note",
    rows: [
      ["c i w", "Change a word"],
      ['d i "', "Delete inside quotes"],
      ["/ n N", "Search and jump"],
      ["g g G", "Top and bottom"],
    ],
  },
];

// Typed as a whole, so these read as commands rather than caps.
const commands = [
  [":e <note>", "Open a note"],
  [":canvas", "New canvas"],
  [":ai <prompt>", "Ask the agent"],
  [":wq", "Save and close"],
];
---

<section id="keyboard" class="section">
  <div class="wrap">
    <div class="reveal">
      <h2 class="heading-4 md:heading-2">Use it without a mouse</h2>
      <p class="body-3 muted lede">
        Panes, tabs, the file tree and the agent panel all work from the keyboard. Vim mode is optional, and covers motions,
        operators, text objects, registers and a <code>:</code> command line.
      </p>
      <p class="caption-2 quiet try">
        Two of them work on this page: <kbd class="key">g</kbd> <kbd class="key">g</kbd> goes to the top and <kbd class="key">G</kbd> to the bottom.
      </p>
    </div>

    <div class="clip reveal">
      <Demo
        name="keyboard"
        alt="Using only the keyboard in Logia: finding a note with Ctrl P, changing a word with Vim's ciw, then moving through the file explorer. Each key pressed appears on screen."
      />
    </div>

    <div class="sheet reveal">
      {
        groups.map((group) => (
          <div class="group card">
            <h3 class="title-4">{group.name}</h3>
            <dl>
              {group.rows.map(([keys, action]) => (
                <div class="row">
                  <dt>
                    {keys.split(" ").map((key, index) =>
                      key === "/" && index > 0 ? <span class="caption-5 quiet">or</span> : <kbd class="key">{key}</kbd>,
                    )}
                  </dt>
                  <dd class="body-6 muted">{action}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
      <div class="group card">
        <h3 class="title-4">Command line</h3>
        <dl>
          {
            commands.map(([command, action]) => (
              <div class="row">
                <dt class="command body-5 mono">{command}</dt>
                <dd class="body-6 muted">{action}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  // The same gg and G the sheet lists. Left alone while typing or with a modifier held.
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let lastG = 0;

  document.addEventListener("keydown", (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey) return;
    if ((event.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;

    const behavior: ScrollBehavior = calm ? "auto" : "smooth";
    if (event.key === "G") {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior });
    } else if (event.key === "g") {
      if (event.timeStamp - lastG < 500) {
        window.scrollTo({ top: 0, behavior });
        lastG = 0;
      } else {
        lastG = event.timeStamp;
      }
    }
  });
</script>

<style>
  .lede {
    margin-top: var(--s-200);
    max-width: 680px;
  }

  .lede code {
    color: var(--ink-100);
  }

  /* Touch screens have no keys to press. */
  .try {
    display: none;
    margin-top: var(--s-200);
  }

  @media (hover: hover) and (pointer: fine) {
    .try {
      display: block;
    }
  }

  .clip {
    margin-top: var(--s-400);
  }

  .sheet {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-200);
    margin-top: var(--s-200);
  }

  .group {
    padding: var(--s-300);
  }

  dl {
    display: grid;
    gap: var(--s-200);
    margin-top: var(--s-200);
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-50);
    min-height: var(--s-300);
  }

  .command {
    color: var(--ember-300);
  }

  dd {
    margin-top: var(--s-50);
  }
</style>
