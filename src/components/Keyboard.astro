---
import Demo from "./Demo.astro";
import Dither from "./Dither.astro";

// Every binding here comes from the app's README. Keep them in step with it.
// Keys are space separated, one cap each. A "/" after the first key reads as "or".
const groups = [
  {
    name: "Anywhere",
    rows: [
      ["Ctrl P", "Find a note"],
      ["Ctrl Shift P", "Run a command"],
      ["Ctrl H / L", "Switch pane"],
      ["Ctrl \\", "Toggle sidebar"],
    ],
  },
  {
    name: "Leader",
    note: "Vim on",
    rows: [
      ["Space e", "File explorer"],
      ["Space f", "Find a note"],
      ["Space a", "Agent panel"],
      ["Space t", "Task board"],
    ],
  },
  {
    name: "In a note",
    rows: [
      ["c i w", "Change word"],
      ['d i "', "Delete in quotes"],
      ["/ n N", "Search, jump"],
      ["g g G", "Top, bottom"],
    ],
  },
];

// Typed as a whole, so these read as commands rather than caps.
const commands = [
  [":e <note>", "Open a note"],
  [":canvas", "New canvas"],
  [":ai <prompt>", "Ask the agent"],
  [":wq", "Save and close"],
];
---

<section id="keyboard" class="section">
  <div class="wrap">
    <div class="reveal">
      <h2 class="heading-4 md:heading-2">Your hands never leave the keys</h2>
      <p class="body-3 muted lede">
        Panes, tabs, the file tree and the agent panel all answer to the keyboard. Switch on Vim mode for motions, operators,
        text objects, registers and a real <code>:</code> command line.
      </p>
      <p class="caption-2 quiet try">
        Try it here: <kbd class="key">g</kbd> <kbd class="key">g</kbd> jumps to the top, <kbd class="key">G</kbd> to the bottom.
      </p>
    </div>

    <div class="clip reveal">
      <Demo
        name="keyboard"
        alt="Using only the keyboard in Logia: finding a note with Ctrl P, changing a word with Vim's ciw, then moving through the file explorer. Each key pressed appears on screen."
      />
    </div>

    <div class="sheet reveal">
      <Dither x={0.5} y={0} spread={0.4} />
      <p class="bar caption-5 mono">
        <span class="mode">NORMAL</span>
        <span class="quiet">cheat sheet</span>
      </p>
      <div class="cols">
        {
          groups.map((group) => (
            <div class="group">
              <h3 class="label caption-4 mono">
                {group.name}
                {group.note && <span class="quiet">· {group.note}</span>}
              </h3>
              <dl>
                {group.rows.map(([keys, action]) => (
                  <div class="row">
                    <dt>
                      {keys.split(" ").map((key, index) =>
                        key === "/" && index > 0 ? <span class="caption-5 quiet">or</span> : <kbd class="key">{key}</kbd>,
                      )}
                    </dt>
                    <dd class="body-6 muted">{action}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
        <div class="group">
          <h3 class="label caption-4 mono">Command line</h3>
          <dl>
            {
              commands.map(([command, action]) => (
                <div class="row">
                  <dt class="command body-5 mono">{command}</dt>
                  <dd class="body-6 muted">{action}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The same gg and G the sheet lists. Left alone while typing or with a modifier held.
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let lastG = 0;

  document.addEventListener("keydown", (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey) return;
    if ((event.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;

    const behavior: ScrollBehavior = calm ? "auto" : "smooth";
    if (event.key === "G") {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior });
    } else if (event.key === "g") {
      if (event.timeStamp - lastG < 500) {
        window.scrollTo({ top: 0, behavior });
        lastG = 0;
      } else {
        lastG = event.timeStamp;
      }
    }
  });
</script>

<style>
  .lede {
    margin-top: var(--s-200);
    max-width: 680px;
  }

  .lede code {
    color: var(--ink-100);
  }

  /* Touch screens have no keys to press. */
  .try {
    display: none;
    margin-top: var(--s-200);
  }

  @media (hover: hover) and (pointer: fine) {
    .try {
      display: block;
    }
  }

  .clip {
    margin-top: var(--s-400);
  }

  /* One panel, like a which-key popup: a mode line on top, then the groups in columns. */
  .sheet {
    position: relative;
    overflow: hidden;
    margin-top: var(--s-200);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-1);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-100);
    padding: var(--s-100) var(--s-300);
    border-bottom: 1px solid var(--line);
  }

  .mode {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--ember-500);
    color: var(--bg-0);
    font-weight: 600;
  }

  .cols {
    position: relative;
    display: grid;
  }

  .group {
    padding: var(--s-300);
  }

  .group + .group {
    border-top: 1px solid var(--line);
  }

  .label {
    display: flex;
    gap: var(--s-50);
    color: var(--ember-300);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  dl {
    display: grid;
    gap: var(--s-100);
    margin-top: var(--s-200);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-200);
  }

  dt {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--s-50);
    min-height: var(--s-300);
  }

  dd {
    text-align: right;
  }

  .command {
    color: var(--ink-100);
  }

  @media (min-width: 640px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .group + .group {
      border-top: 0;
    }

    .group:nth-child(even) {
      border-left: 1px solid var(--line);
    }

    .group:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (min-width: 1100px) {
    .cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .group:nth-child(n + 2) {
      border-left: 1px solid var(--line);
    }

    .group:nth-child(n + 3) {
      border-top: 0;
    }
  }
</style>
