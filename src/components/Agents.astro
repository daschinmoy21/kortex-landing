---
import AgentLogos from "./AgentLogos.astro";

const points = [
  ["Edits land as you watch", "Agents write through the running app, into the same editor and save queue you type into."],
  ["Nothing gets clobbered", "A full rewrite has to name the revision it read. If the note moved on since, the write is refused."],
  ["Your permissions, untouched", "Each CLI keeps its own approval rules. Logia never adds flags to skip them."],
];
---

<section id="agents" class="section">
  <div class="wrap grid reveal">
    <div>
      <h2 class="heading-4 md:heading-2">Your coding agent, right beside the note</h2>
      <p class="body-3 muted lede">
        Claude Code, Codex and friends run in the side panel on the login you already have. Logia doesn't touch your credentials. The
        agent gets the open note with each message, unsaved edits included, unless you leave it out.
      </p>

      <AgentLogos class="agent-logos" />

      <ul class="points">
        {
          points.map(([name, detail]) => (
            <li>
              <h3 class="title-3">{name}</h3>
              <p class="body-6 muted">{detail}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="term" role="img" aria-label="Terminal example: an agent searches, appends to a note, and has a stale rewrite rejected">
      <div class="term-head caption-5 quiet mono"><span>logia-cli</span><span>talks to the running app</span></div>
      <pre class="body-6"><code><span class="c"># see the note, unsaved edits included</span>
<span class="p">$</span> logia-cli read

<span class="c"># find something across your notes</span>
<span class="p">$</span> logia-cli search query="meeting notes"

<span class="c"># add to a note; it appears as you watch</span>
<span class="p">$</span> logia-cli append file="Plan" content="- [ ] Review"

<span class="c"># replace it, but only if nothing has changed</span>
<span class="p">$</span> logia-cli write id=NOTE_ID ifRevision=REVISION --stdin
&#123; "error": &#123;
    "code": "<span class="e">REVISION_CONFLICT</span>",
    "message": "Note changed. Read it again before editing."
&#125; &#125;</code></pre>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--s-500);
    align-items: center;
  }

  .lede {
    margin-top: var(--s-200);
    max-width: 680px;
  }

  .grid :global(.agent-logos) {
    margin-top: var(--s-300);
  }

  .points {
    display: grid;
    gap: var(--s-200);
    margin-top: var(--s-400);
  }

  .points p {
    margin-top: var(--s-25);
  }

  /* 16px shell with an 8px inset code panel inside (B3). */
  .term {
    min-width: 0;
    padding: var(--s-75);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-1);
  }

  .term-head {
    display: flex;
    justify-content: space-between;
    gap: var(--s-100);
    padding: var(--s-75) var(--s-100) var(--s-100);
  }

  pre {
    margin: 0;
    padding: var(--s-200);
    overflow-x: auto;
    border-radius: 8px;
    background: var(--bg-0);
    color: var(--ink-100);
  }

  .c {
    color: var(--ink-500);
  }

  .p {
    color: var(--ember-400);
  }

  .e {
    color: var(--ember-300);
    font-weight: 600;
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--s-700);
    }
  }
</style>
