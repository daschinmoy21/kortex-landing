---
// A recording of the real app. People who ask for less motion get the final frame instead.
interface Props {
  name: "hero" | "agent" | "keyboard" | "tour" | "audio";
  alt: string;
  eager?: boolean;
}
const { name, alt, eager = false } = Astro.props;
---

<figure class="demo">
  <picture>
    <source srcset={`/demos/${name}-poster.png`} media="(prefers-reduced-motion: reduce)" />
    <img src={`/demos/${name}.gif`} alt={alt} width="1200" height="750" loading={eager ? "eager" : "lazy"} decoding="async" />
  </picture>
</figure>

<style>
  /* 16px shell, 8px inset, 8px image radius (B3). */
  .demo {
    padding: var(--s-75);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-1);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: var(--bg-2);
  }

  /* On a phone the frame eats width the recording needs. */
  @media (max-width: 767px) {
    .demo {
      padding: var(--s-50);
      border-radius: 12px;
    }
  }
</style>
