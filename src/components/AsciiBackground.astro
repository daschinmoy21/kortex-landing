---
// The site's one background, fixed behind every page. On the home page it starts sharp behind the
// hero and settles into a blurred glow as you scroll. Other pages start settled, so their text never
// sits on bright glyphs.
interface Props {
  settled?: boolean;
}
const { settled = false } = Astro.props;
---

<div class="ascii" data-ascii-background data-settled={settled ? "" : undefined} aria-hidden="true">
  <div class="field">
    <canvas data-gradient-ascii></canvas>
  </div>
  <div class="veil"></div>
</div>

<script>
  import { mountGradientAscii } from "../scripts/gradient-ascii";

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-gradient-ascii]").forEach(mountGradientAscii);

  const background = document.querySelector<HTMLElement>("[data-ascii-background]");
  if (background && !background.hasAttribute("data-settled")) {
    let queued = false;

    const update = () => {
      queued = false;
      const progress = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.7)));
      background.style.setProperty("--settle", progress.toFixed(3));
    };

    const request = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request, { passive: true });
    update();
  }
</script>

<style>
  .ascii {
    --settle: 0;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .ascii[data-settled] {
    --settle: 1;
  }

  /* Raised so the palest band runs behind the nav and the arch curves down around the hero copy.
     It fades to transparent below the arch, so it needs no edge or mask where it meets the page. */
  .field {
    position: absolute;
    inset: -26vh 0 auto;
    height: 100vh;
    min-height: 720px;
    max-height: 1040px;
    opacity: calc(1 - 0.8 * var(--settle));
    transform: translateY(calc(var(--settle) * 18vh));
  }

  /* The blur itself is constant. Fading this layer in is cheaper than animating a filter radius. */
  .veil {
    position: absolute;
    inset: 0;
    opacity: var(--settle);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .field {
      transform: none;
    }
  }

  /* Powers on like an old screen: rows of glyphs appear top to bottom in coarse steps,
     with a flicker of brightness as it settles. */
  @media (prefers-reduced-motion: no-preference) {
    .ascii:not([data-settled]) .field canvas {
      animation:
        scan 1100ms steps(18, end) both,
        flicker 1400ms linear both;
    }

    .ascii[data-settled] .field canvas {
      animation: flicker 900ms linear both;
    }
  }

  @keyframes scan {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes flicker {
    0% { opacity: 0; filter: brightness(2.2); }
    12% { opacity: 0.9; }
    18% { opacity: 0.35; }
    28% { opacity: 1; filter: brightness(1.6); }
    36% { opacity: 0.7; }
    100% { opacity: 1; filter: brightness(1); }
  }
</style>
