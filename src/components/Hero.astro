---
import Demo from "./Demo.astro";
import Icon from "./Icon.astro";
import { links, release } from "../data/release";
---

<section class="hero">
  <div class="print" aria-hidden="true">
    <picture>
      <source
        type="image/webp"
        srcset="/hero/desert-1280.webp 1280w, /hero/desert-1920.webp 1920w, /hero/desert-2752.webp 2752w"
        sizes="100vw"
      />
      <img src="/hero/desert-1920.jpg" alt="" width="1920" height="1072" fetchpriority="high" decoding="async" />
    </picture>
    <div class="glass"></div>
    <div class="glass thin"></div>
  </div>
  <div class="wrap">
    <div class="copy">
      <h1 class="display"><span><span class="scribble">Notes</span> <span class="w" style="--i: 1">at</span> <span class="w" style="--i: 2">the</span></span> <span><span class="w" style="--i: 3">speed</span> <span class="w" style="--i: 4">of</span> <img class="vim" src="/vim-logo.svg" alt="Vim" width="544" height="545" /></span></h1>
      <p class="lede enter" style="--d: 760ms">
        Blocks, backlinks and canvases, synced with Git and kept on your disk.
      </p>
      <a href="/downloads" class="btn btn-primary cta enter" style="--d: 880ms"><Icon name="download" /> Download Logia</a>
      <a href={links.repo} class="source title-3 enter" style="--d: 980ms" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        Read the code on GitHub
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <p class="caption-2 phone enter" style="--d: 1060ms">Android app coming soon · <span class="mono">v{release.version}</span> · AGPL 3.0</p>
      {
        !release.current && (
          <p class="caption-5 behind">
            This release is older than the app shown here. <a class="link" href="/downloads#main">Build from main</a> for the latest.
          </p>
        )
      }
    </div>

    <div class="shot enter-shot">
      <Demo
        name="hero"
        eager
        alt="Logia driven from the keyboard. The command palette opens a Rust note on a token bucket rate limiter, and Space a opens Claude Code in the side panel. Asked for a diagram, the agent adds a rendered Mermaid flowchart of the request path to the note. Asked for a playground, it adds a live artifact with capacity and refill-rate sliders and a chart of tokens, and dragging the sliders changes how many requests are rejected."
      />
    </div>
  </div>
</section>

<script>
  // Frost the print over the first screen of scrolling: clear at the top, full glass once the
  // hero copy has scrolled away.
  const print = document.querySelector<HTMLElement>(".hero .print");
  if (print) {
    let queued = false;
    const update = () => {
      queued = false;
      const t = Math.min(1, Math.max(0, (scrollY - innerHeight * 0.15) / (innerHeight * 0.55)));
      // Thin it over the last screen and a half before the bottom of the page.
      const left = document.documentElement.scrollHeight - innerHeight - scrollY;
      const thaw = Math.min(1, Math.max(0, 1 - left / (innerHeight * 1.5)));
      print.style.setProperty("--glass", t.toFixed(3));
      print.style.setProperty("--thaw", thaw.toFixed(3));
    };
    addEventListener("scroll", () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--s-900) + var(--s-400));
    padding-bottom: var(--s-700);
  }

  /* The riso print stays behind the whole page. Its sky is flat cobalt, so the copy sits on it and
     the image is pinned to the bottom: a taller screen just shows more sky. As the page scrolls, a
     pane of frosted glass slides over it (--glass, 0 to 1, set by the script below), so the rest of
     the page sits on the print's own colours, blurred and dimmed enough to read on. */
  .print {
    position: fixed;
    inset: 0;
    z-index: -1;
    height: 100lvh;
    background: var(--sky);
  }

  .print img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  /* backdrop-filter is applied once at full strength and only its opacity follows the scroll, so
     scrolling never re-rasterises the blur. */
  .glass {
    position: absolute;
    inset: 0;
    background: rgb(14 22 48 / 0.5);
    -webkit-backdrop-filter: blur(28px) saturate(1.2);
    backdrop-filter: blur(28px) saturate(1.2);
    opacity: calc(var(--glass, 0) * (1 - var(--thaw, 0)));
  }

  /* Near the footer the frost thins out (--thaw, 0 to 1) and the print shows through again. */
  .thin {
    background: rgb(14 22 48 / 0.18);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    opacity: calc(var(--glass, 0) * var(--thaw, 0));
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .display {
    max-width: 13ch;
    color: var(--ink-100);
    font: 600 clamp(40px, 7.2vw, 92px) / 1 var(--sans);
    letter-spacing: -0.045em;
    text-wrap: balance;
    /* A coral plate printed slightly off register, like the print behind it. */
    text-shadow: 0.035em 0.035em 0 rgb(228 108 97 / 0.85);
  }

  /* Handwritten, like a note. Caveat runs small, so it is scaled up to sit level with the sans. */
  .scribble {
    display: inline-block;
    margin-right: 0.04em;
    font-family: "Caveat", cursive;
    font-size: 1.28em;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.8;
    transform: rotate(-3deg);
  }

  /* The word Vim is the Vim logo itself. */
  .vim {
    display: inline-block;
    width: auto;
    height: 1.18em;
    margin-left: 0.04em;
    vertical-align: -0.24em;
    filter: drop-shadow(0 8px 24px var(--shadow));
  }

  .lede {
    max-width: 620px;
    margin-top: var(--s-300);
    color: var(--ink-100);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    text-wrap: pretty;

  }

  .cta {
    margin-top: var(--s-500);
    padding: var(--s-100) var(--s-300);
    border-radius: 10px;
    font-size: 17px;
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: var(--s-75);
    margin-top: var(--s-300);
    color: var(--ink-100);
    transition: color 300ms var(--curve);
  }

  .source:hover {
    color: var(--ember-300);
  }

  .source svg {
    width: 18px;
    height: 18px;
  }

  .arrow {
    color: var(--ink-300);
    font-size: 13px;
  }

  .phone {
    margin-top: var(--s-200);
    color: var(--ink-300);
  }

  .behind {
    margin-top: var(--s-100);
    color: var(--ink-300);
  }

  .shot {
    margin-top: var(--s-700);
    filter: drop-shadow(0 32px 64px var(--shadow));
  }

  /* Phones only see a narrow slice of the print. Make it taller, slide it to the king, and drop
     the demo lower so the pieces show between the copy and the demo instead of behind it. */
  @media (max-width: 767px) {
    /* Sink the pieces below the copy; the print's flat sky fills the gap above. */
    .print img {
      object-position: 24% 100%;
      transform: translateY(12%);
    }

    .shot {
      margin-top: 300px;
    }
  }

  /* One line per half of the sentence once there is room for it. */
  @media (min-width: 768px) {
    .display {
      max-width: none;
    }

    .display > span {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: calc(2 * var(--s-900));
    }
  }
  /* Opening sequence. "Notes" is written on like ink, the other words rise out of a blur one by one,
     the Vim logo pops in last, then the rest of the hero and the demo follow. */
  @media (prefers-reduced-motion: no-preference) {
    .scribble {
      animation: ink 900ms cubic-bezier(0.65, 0, 0.35, 1) 150ms backwards;
    }

    .w {
      display: inline-block;
      animation: rise 900ms var(--curve) calc(220ms + var(--i) * 90ms) backwards;
    }

    .vim {
      animation: pop 900ms cubic-bezier(0.34, 1.56, 0.64, 1) 640ms backwards;
    }

    .enter {
      animation: lift 800ms var(--curve) var(--d) backwards;
    }

    .shot {
      perspective: 1600px;
    }

    .enter-shot > :global(*) {
      transform-origin: 50% 0;
      animation: tilt 1400ms var(--curve) 1000ms backwards;
    }

    /* One shine across the button once it has landed. */
    .cta {
      position: relative;
      overflow: hidden;
    }

    .cta::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, transparent 30%, rgb(252 236 214 / 0.6) 50%, transparent 70%);
      transform: translateX(-120%);
      animation: shine 1100ms var(--curve) 1700ms both;
      pointer-events: none;
    }
  }

  @keyframes ink {
    from {
      clip-path: inset(-20% 100% -20% -10%);
      opacity: 0.4;
    }
    to {
      clip-path: inset(-20% -10% -20% -10%);
      opacity: 1;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translateY(0.4em);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-25deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lift {
    from {
      opacity: 0;
      transform: translateY(var(--s-300));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes tilt {
    from {
      opacity: 0;
      transform: translateY(var(--s-700)) rotateX(18deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes shine {
    to {
      transform: translateX(120%);
    }
  }
</style>
