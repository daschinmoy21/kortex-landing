---
import AgentLogos from "./AgentLogos.astro";
import Demo from "./Demo.astro";
import Icon from "./Icon.astro";
import { release } from "../data/release";
---

<section class="hero">
  <div class="wrap">
    <div class="copy">
      <h1 class="heading-3 md:heading-1">
        <span class="line">A local notes app</span>
        <span class="line">your agent can edit</span>
      </h1>
      <p class="body-3 lede">
        Logia is a free, open source desktop app for notes and canvases. Notes are JSON files on your disk. Claude Code, Codex
        and other CLIs run in a side panel and edit the note you have open.
      </p>
      <div class="action">
        <a href="/downloads" class="btn btn-primary"><Icon name="download" /> Download Logia</a>
        <span class="caption-5 mono meta">v{release.version} · AGPL 3.0</span>
      </div>
      {
        !release.current && (
          <p class="caption-5 behind">
            This release is older than the app shown here. <a class="link" href="/downloads#main">Build from main</a> for the latest.
          </p>
        )
      }
      <div class="proof">
        <span class="caption-2 meta">Works with</span>
        <AgentLogos class="row" />
      </div>
    </div>

    <div class="shot">
      <Demo
        name="agent"
        eager
        alt="Logia with a note open. Claude Code is asked in the side panel to turn the note's open questions into a task list, and the tasks appear in the note."
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--s-900) + var(--s-400));
    padding-bottom: var(--s-700);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    max-width: 680px;
    color: #ffffff;
    text-shadow: 0 0 32px rgb(0 0 0 / 0.55);
  }

  .lede {
    max-width: 680px;
    margin-top: var(--s-300);
    color: var(--ink-100);
    text-shadow: 0 0 16px rgb(0 0 0 / 0.8);
  }

  .action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-100) var(--s-200);
    margin-top: var(--s-400);
  }

  .meta {
    color: var(--ink-300);
  }

  .behind {
    margin-top: var(--s-100);
    color: var(--ink-300);
  }

  .proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-100);
    margin-top: var(--s-500);
  }

  .proof :global(.row) {
    justify-content: center;
  }

  .shot {
    margin-top: var(--s-600);
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: calc(2 * var(--s-900));
    }

    .proof {
      flex-direction: row;
      gap: var(--s-300);
    }
  }
</style>
