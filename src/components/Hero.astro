---
import PixelCanvas from "./PixelCanvas.astro";
import CopyCommand from "./CopyCommand.astro";
import Demo from "./Demo.astro";
import { nixReleaseCommand, release } from "../data/release";
---

<section class="hero">
  <PixelCanvas class="scene" />
  <div class="wrap copy">
    <h1 class="display">The notes app that lets your agents in.</h1>
    <p class="lede">
      Logia is a free, open-source desktop app for notes and canvases. Your notes live on your machine, everything is a
      keystroke away, and Claude Code or Codex can work on your notes while you watch.
    </p>

    <div class="card">
      <CopyCommand command={nixReleaseCommand} />
      <div class="card-row">
        <span class="meta">Release v{release.version} · AGPL-3.0</span>
        <a href="/downloads" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path></svg>
          Download
        </a>
      </div>
    </div>

    {
      !release.current && (
        <p class="behind">
          This release is older than the app shown below. <a class="link" href="/downloads#main">Build from main</a> for the latest.
        </p>
      )
    }
  </div>

  <div class="wrap shot">
    <Demo
      name="agent"
      eager
      alt="Logia with a note open. Claude Code is asked in the side panel to turn the note's open questions into a task list, and the tasks appear in the note."
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--ink-950);
    padding-block: clamp(72px, 13vh, 136px) clamp(48px, 8vw, 96px);
  }

  .hero :global(.scene) {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    display: block;
    width: 100%;
    height: min(720px, 92vh);
    background: var(--panel);
    pointer-events: none;
    user-select: none;
    mask-image: linear-gradient(to bottom, black 58%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 58%, transparent 100%);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .display {
    max-width: 15ch;
    text-shadow: 0 0 28px var(--panel), 0 0 8px var(--panel);
  }

  .lede {
    margin-top: 20px;
    color: var(--ink-300);
    text-shadow: 0 0 16px var(--panel), 0 0 4px var(--panel);
  }

  .card {
    width: 100%;
    max-width: 560px;
    margin-top: 32px;
    padding: 6px;
    border: 1px solid var(--ink-800);
    border-radius: 12px;
    background: var(--ink-900);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5);
    text-align: left;
  }

  .card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 4px 4px 10px;
  }

  .meta {
    color: var(--ink-500);
    font: 400 12px/1.4 var(--mono);
  }

  .behind {
    margin-top: 14px;
    color: var(--ink-400);
    font-size: 13px;
    text-shadow: 0 0 12px var(--panel), 0 0 4px var(--panel);
  }

  .shot {
    margin-top: clamp(48px, 7vw, 80px);
  }
</style>
