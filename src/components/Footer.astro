---
import { links } from "../data/release";
---

<footer class="footer">
  <div class="wrap row">
    <span class="mark">Logia</span>
    <span class="note">Free and open source, under AGPL-3.0.</span>
    <nav aria-label="Footer">
      <a href="/downloads">Download</a>
      <a href={links.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={links.license} target="_blank" rel="noopener noreferrer">License</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ink-800);
    background: var(--ink-925);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding-block: 20px;
    color: var(--ink-500);
    font-size: 13px;
  }

  .mark {
    color: var(--ink-100);
    font: 700 13px/1 var(--mono);
  }

  nav {
    display: flex;
    gap: 16px;
    margin-left: auto;
  }

  a {
    display: inline-block;
    padding-block: 4px;
    color: var(--ink-400);
  }

  a:hover {
    color: var(--ink-100);
  }

  @media (max-width: 560px) {
    nav {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
