---
import { links } from "../data/release";
---

<footer class="footer">
  <div class="wrap row caption-2 quiet">
    <a href="/" class="mark title-4">Logia</a>
    <span>Free and open source under AGPL 3.0.</span>
    <nav aria-label="Footer">
      <a href="/downloads">Download</a>
      <a href={links.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={links.license} target="_blank" rel="noopener noreferrer">License</a>
    </nav>
  </div>
</footer>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-75) var(--s-200);
    padding-block: var(--s-300);
  }

  .mark {
    color: var(--ink-100);
  }

  nav {
    display: flex;
    gap: var(--s-200);
    margin-left: auto;
  }

  nav a {
    display: inline-block;
    padding-block: var(--s-50);
    color: var(--ink-400);
    transition: color 300ms var(--curve);
  }

  nav a:hover {
    color: var(--ink-100);
  }

  @media (max-width: 559px) {
    nav {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
