---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import AsciiBackground from "../components/AsciiBackground.astro";

interface Props {
  title?: string;
  description?: string;
  /** The home page's sharp background behind the hero. Every other page starts with it settled. */
  sharpHero?: boolean;
}

const {
  sharpHero = false,
  title = "Logia: a local notes app your agent can edit",
  description = "A free, open source desktop app for notes and canvases. Notes are files on your disk, Vim mode is optional, and Claude Code, Codex and other CLIs can edit the note you have open.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:url" content="https://getlogia.online" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://getlogia.online/og.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="getlogia.online" />
    <meta property="twitter:url" content="https://getlogia.online" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://getlogia.online/og.png" />

    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
  </head>
  <body>
    <AsciiBackground settled={!sharpHero} />
    <a class="skip" href="#content">Skip to content</a>
    <slot name="header" />
    <main id="content">
      <slot />
    </main>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("in");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
